using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: _("Webdict");
  default-width: 960;
  default-height: 680;
  width-request: 360;
  height-request: 480;

  Adw.Breakpoint {
    condition ("max-width: 650sp")
    setters { split_view.collapsed: true; }
  }

  content: Adw.NavigationSplitView split_view {
    min-sidebar-width: 280;
    max-sidebar-width: 360;
    sidebar-width-fraction: 0.34;

    sidebar: Adw.NavigationPage {
      title: _("Search");
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-end-title-buttons: false;
          title-widget: Adw.WindowTitle {
            title: _("Webdict");
          };

          [start]
          $WebdictEditionDropdown edition_dropdown {
            tooltip-text: _("Wiktionary language edition");
            hexpand: true;
          }

          [end]
          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Main Menu");
            menu-model: main_menu;
          }
        }

        content: Gtk.Box {
          styles ["search-panel"]
          orientation: vertical;
          spacing: 18;

          Gtk.SearchEntry search_entry {
            styles ["search-box"]
            placeholder-text: _("Enter a word…");
            hexpand: true;
          }

          Gtk.Stack suggestion_stack {
            vexpand: true;
            transition-type: crossfade;

            Gtk.StackPage {
              name: "empty";
              child: Gtk.Label {
                styles ["dim-label"]
                label: _("Definitions are sourced from the selected Wiktionary edition.");
                wrap: true;
                justify: center;
                valign: center;
                margin-start: 12;
                margin-end: 12;
              };
            }
            Gtk.StackPage {
              name: "loading";
              child: Gtk.Spinner {
                spinning: true;
                halign: center;
                valign: center;
              };
            }
            Gtk.StackPage {
              name: "suggestions";
              child: Gtk.ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;
                Gtk.ListBox suggestion_list {
                  styles ["navigation-sidebar"]
                  selection-mode: none;
                }
              };
            }
          }
        };
      };
    };

    content: Adw.NavigationPage {
      title: _("Definition");
      child: Adw.NavigationView definition_navigation {
        $WebdictDefinitionPage definition_page {}
      };
    };
  };
}

menu main_menu {
  item (_("About Webdict"), "app.about")
  item (_("Quit"), "app.quit")
}
