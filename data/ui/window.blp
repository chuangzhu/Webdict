using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: _("Webdict");
  default-width: 960;
  default-height: 680;
  width-request: 360;
  height-request: 480;

  Adw.Breakpoint {
    condition ("max-width: 650sp")
    setters { split_view.collapsed: true; }
  }

  content: Adw.NavigationSplitView split_view {
    min-sidebar-width: 280;
    max-sidebar-width: 360;
    sidebar-width-fraction: 0.34;

    sidebar: Adw.NavigationPage {
      title: _("Search");
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-end-title-buttons: false;
          title-widget: Adw.WindowTitle {
            title: _("Webdict");
          };
          [start]
          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Main Menu");
            menu-model: main_menu;
          }
        }

        content: Gtk.Box {
          styles ["search-panel"]
          orientation: vertical;
          spacing: 18;

          Gtk.Box {
            styles ["linked", "search-box"]
            Gtk.SearchEntry search_entry {
              placeholder-text: _("Enter a word…");
              hexpand: true;
            }
            Gtk.Button search_button {
              styles ["suggested-action"]
              icon-name: "system-search-symbolic";
              tooltip-text: _("Search");
            }
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 6;
            Gtk.Label {
              styles ["heading"]
              label: _("Wiktionary edition");
              halign: start;
            }
            Gtk.DropDown edition_dropdown {
              tooltip-text: _("Wiktionary language edition");
              hexpand: true;
            }
          }
        };

        [bottom]
        Gtk.Box {
          orientation: vertical;
          spacing: 8;
          margin-start: 24;
          margin-end: 24;
          margin-bottom: 18;

          Gtk.Separator {}

          Gtk.Label {
            styles ["dim-label"]
            label: _("Definitions are sourced from the selected Wiktionary edition.");
            wrap: true;
            justify: center;
          }
        }
      };
    };

    content: Adw.NavigationPage {
      title: _("Definition");
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          title-widget: Adw.WindowTitle { title: _("Definition"); };
        }

        content: Gtk.Stack content_stack {
          vexpand: true;
          transition-type: crossfade;

          Gtk.StackPage {
            name: "welcome";
            child: Adw.StatusPage {
              icon-name: "io.github.webdict.Webdict";
              title: _("A world of words");
              description: _("Choose an edition and start exploring.");
            };
          }
          Gtk.StackPage {
            name: "loading";
            child: Gtk.Box {
              orientation: vertical;
              valign: center;
              halign: center;
              spacing: 16;
              Gtk.Spinner { spinning: true; width-request: 36; height-request: 36; }
              Gtk.Label { styles ["title-3"] label: _("Looking it up…"); }
            };
          }
          Gtk.StackPage {
            name: "error";
            child: Adw.StatusPage {
              icon-name: "dialog-warning-symbolic";
              title: _("No definition here");
              description: _("Check the spelling or try another edition.");
              child: Gtk.Box {
                orientation: vertical;
                spacing: 12;
                Gtk.Label error_label { wrap: true; }
                Gtk.Button retry_button {
                  styles ["pill"]
                  label: _("Try Again");
                  halign: center;
                }
              };
            };
          }
          Gtk.StackPage {
            name: "result";
            child: Gtk.Box {
              orientation: vertical;
              Gtk.Box {
                styles ["result-heading"]
                spacing: 12;
                Gtk.Box {
                  orientation: vertical;
                  hexpand: true;
                  Gtk.Label result_title {
                    styles ["title-1"]
                    halign: start;
                    ellipsize: end;
                  }
                  Gtk.Label result_subtitle {
                    styles ["dim-label"]
                    halign: start;
                  }
                }
                Gtk.Button open_button {
                  styles ["flat"]
                  icon-name: "external-link-symbolic";
                  tooltip-text: _("Open on Wiktionary");
                  valign: center;
                }
              }
              Gtk.ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;
                Gtk.TextView result_text {
                  styles ["definition"]
                  editable: false;
                  cursor-visible: false;
                  wrap-mode: word;
                  top-margin: 24;
                  bottom-margin: 48;
                  left-margin: 32;
                  right-margin: 32;
                  pixels-below-lines: 3;
                }
              }
            };
          }
        };
      };
    };
  };
}

menu main_menu {
  item (_("About Webdict"), "app.about")
  item (_("Quit"), "app.quit")
}
