using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: _("Webdict");
  default-width: 960;
  default-height: 680;
  width-request: 360;
  height-request: 480;

  Adw.Breakpoint {
    condition ("max-width: 650sp")
    setters { split_view.collapsed: true; }
  }

  content: Adw.NavigationSplitView split_view {
    min-sidebar-width: 280;
    max-sidebar-width: 360;
    sidebar-width-fraction: 0.34;

    sidebar: Adw.NavigationPage {
      title: _("Search");
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-end-title-buttons: false;
          title-widget: Adw.WindowTitle {
            title: _("Webdict");
          };

          [start]
          Gtk.DropDown edition_dropdown {
            tooltip-text: _("Wiktionary language edition");
            hexpand: true;
          }

          [end]
          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Main Menu");
            menu-model: main_menu;
          }
        }

        content: Gtk.Box {
          styles ["search-panel"]
          orientation: vertical;
          spacing: 18;

          Gtk.SearchEntry search_entry {
            styles ["search-box"]
            placeholder-text: _("Enter a word…");
            hexpand: true;
          }

          Gtk.Stack suggestion_stack {
            vexpand: true;
            transition-type: crossfade;

            Gtk.StackPage {
              name: "empty";
              child: Gtk.Label {
                styles ["dim-label"]
                label: _("Definitions are sourced from the selected Wiktionary edition.");
                wrap: true;
                justify: center;
                valign: center;
                margin-start: 12;
                margin-end: 12;
              };
            }
            Gtk.StackPage {
              name: "loading";
              child: Gtk.Spinner {
                spinning: true;
                halign: center;
                valign: center;
              };
            }
            Gtk.StackPage {
              name: "suggestions";
              child: Gtk.ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;
                Gtk.ListBox suggestion_list {
                  styles ["navigation-sidebar"]
                  selection-mode: none;
                }
              };
            }
          }
        };
      };
    };

    content: Adw.NavigationPage {
      title: _("Definition");
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          title-widget: Adw.WindowTitle { title: _("Definition"); };
          [end]
          Gtk.MenuButton {
            icon-name: "view-more-symbolic";
            tooltip-text: _("Definition Menu");
            menu-model: definition_menu;
          }
        }

        content: Gtk.Stack content_stack {
          vexpand: true;
          transition-type: crossfade;

          Gtk.StackPage {
            name: "welcome";
            child: Adw.StatusPage {
              icon-name: "io.github.webdict.Webdict";
              title: _("A world of words");
              description: _("Choose an edition and start exploring.");
            };
          }
          Gtk.StackPage {
            name: "loading";
            child: Gtk.Box {
              orientation: vertical;
              valign: center;
              halign: center;
              spacing: 16;
              Gtk.Spinner { spinning: true; width-request: 36; height-request: 36; }
              Gtk.Label { styles ["title-3"] label: _("Looking it up…"); }
            };
          }
          Gtk.StackPage {
            name: "error";
            child: Adw.StatusPage {
              icon-name: "dialog-warning-symbolic";
              title: _("No definition here");
              description: _("Check the spelling or try another edition.");
              child: Gtk.Box {
                orientation: vertical;
                spacing: 12;
                Gtk.Label error_label { wrap: true; }
                Gtk.Button retry_button {
                  styles ["pill"]
                  label: _("Try Again");
                  halign: center;
                }
              };
            };
          }
          Gtk.StackPage {
            name: "result";
            child: Gtk.Box {
              orientation: vertical;
              Gtk.Box {
                styles ["result-heading"]
                spacing: 12;
                Gtk.Box {
                  orientation: vertical;
                  hexpand: true;
                  Gtk.Label result_title {
                    styles ["title-1"]
                    halign: start;
                    ellipsize: end;
                  }
                  Gtk.Label result_subtitle {
                    styles ["dim-label"]
                    halign: start;
                  }
                }
              }
              Gtk.ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;
                Gtk.TextView result_text {
                  styles ["definition"]
                  editable: false;
                  cursor-visible: false;
                  wrap-mode: word;
                  top-margin: 24;
                  bottom-margin: 48;
                  left-margin: 32;
                  right-margin: 32;
                  pixels-below-lines: 3;
                }
              }
            };
          }
        };
      };
    };
  };
}

menu main_menu {
  item (_("About Webdict"), "app.about")
  item (_("Quit"), "app.quit")
}

menu definition_menu {
  item (_("Open on Wiktionary"), "app.open-wiktionary")
}
