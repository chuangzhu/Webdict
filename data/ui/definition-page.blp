using Gtk 4.0;
using Adw 1;

Adw.ToolbarView definition_toolbar {
  [top]
  Adw.HeaderBar {
    [end]
    Gtk.MenuButton {
      icon-name: "view-more-symbolic";
      tooltip-text: _("Definition Menu");
      menu-model: definition_menu;
    }
  }

  [top]
  Gtk.SearchBar find_bar {
    show-close-button: true;
    child: Gtk.Box {
      spacing: 6;
      Gtk.SearchEntry find_entry {
        placeholder-text: _("Find in Page");
        hexpand: true;
      }
      Gtk.Button find_previous {
        icon-name: "go-up-symbolic";
        tooltip-text: _("Previous Match");
      }
      Gtk.Button find_next {
        icon-name: "go-down-symbolic";
        tooltip-text: _("Next Match");
      }
    };
  }

  content: Gtk.Stack content_stack {
    vexpand: true;
    transition-type: crossfade;

    Gtk.StackPage {
      name: "welcome";
      child: Adw.StatusPage {
        icon-name: "cz.chuang.Webdict";
        title: _("A world of words");
        description: _("Choose an edition and start exploring.");
      };
    }
    Gtk.StackPage {
      name: "loading";
      child: Gtk.Box {
        orientation: vertical;
        valign: center;
        halign: center;
        spacing: 16;
        Gtk.Spinner { spinning: true; width-request: 36; height-request: 36; }
        Gtk.Label { styles ["title-3"] label: _("Looking it up…"); }
      };
    }
    Gtk.StackPage {
      name: "error";
      child: Adw.StatusPage {
        icon-name: "dialog-warning-symbolic";
        title: _("No definition here");
        description: _("Check the spelling or try another edition.");
        child: Gtk.Box {
          orientation: vertical;
          spacing: 12;
          Gtk.Label error_label { wrap: true; }
          Gtk.Button retry_button {
            styles ["pill"]
            label: _("Try Again");
            halign: center;
          }
        };
      };
    }
    Gtk.StackPage {
      name: "result";
      child: Gtk.ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;
        propagate-natural-height: true;
        $WebdictResultTextView result_text {
          styles ["definition"]
          editable: false;
          cursor-visible: false;
          wrap-mode: word;
          top-margin: 24;
          bottom-margin: 48;
          left-margin: 32;
          right-margin: 32;
          pixels-below-lines: 3;
        }
      };
    }
  };
}

menu definition_menu {
  item (_("Find in Page"), "app.find-in-page")
  item (_("Open on Wiktionary"), "app.open-wiktionary")
}
